# Docker Compose 生产配置。复制为 .env，并生成随机强密码。
POSTGRES_PASSWORD=replace-with-random-production-password
# 浏览器是当前推荐入口；部署时替换为实际 Web Origin。Android Debug 需要 localhost。
ALLOWED_ORIGINS=localhost,127.0.0.1
LOG_LEVEL=info
# 国内服务器构建时可改为 https://goproxy.cn,direct 和 https://registry.npmmirror.com
GOPROXY=https://proxy.golang.org,direct
NPM_REGISTRY=https://registry.npmjs.org
# HTTPS 模式使用。IP 快速模式保持注释。
# PUBLIC_HOST=companion.example.com

# 本机直接运行时可按需设置：
# DATABASE_URL=postgres://codex_companion:<password>@127.0.0.1:5432/codex_companion?sslmode=disable
# RELAY_ADDR=:8080
# CODEX_COMPANION_RELAY_URL=ws://127.0.0.1:8080/ws/bridge
# VITE_RELAY_WS_URL=ws://127.0.0.1:8080/ws/web
